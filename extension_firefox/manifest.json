{
  "manifest_version": 2,
  "name": "PyDM Integration",
  "version": "2.0",
  "description": "إرسال التحميلات والفيديوهات من المتصفح إلى برنامج PyDM",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "tabs", "<all_urls>"],
  "background": { "scripts": ["common.js", "background.js"] },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "PyDM",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": { "gecko": { "id": "pydm@pydm.local", "strict_min_version": "78.0" } }
}
